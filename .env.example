# ==============================================================================
# PULSE DevOps Agent — Environment Variables
# Pipeline Understanding, Learning & Self-healing Engine
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file: copy .env.example .env
#   2. Fill in your actual values below
#   3. NEVER commit .env to git (it's in .gitignore)
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Set to true for detailed logs and SQL query output
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ==============================================================================
# AI / LLM CONFIGURATION
# ==============================================================================
# You need at least ONE of these for AI-powered fixes.
# If neither is set, PULSE runs in OFFLINE mode (rule-based fixes only).

# --- OPTION 1: OpenAI (Recommended for best fix quality) ---
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.002 per fix with gpt-4o-mini (very cheap)
# Free alternative: Sign up for $5 in free credits
OPENAI_API_KEY=

# --- OPTION 2: Google Gemini (Free tier available!) ---
# Get your key at: https://aistudio.google.com/apikey
# Cost: FREE up to 15 requests/minute with gemini-1.5-flash
# Best option if you want ZERO cost
GEMINI_API_KEY=

# Which model to use (gpt-4o-mini is fast and cheap, gpt-4o is smarter)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Gemini model (gemini-1.5-flash is free, gemini-1.5-pro is better)
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# GITHUB CONFIGURATION
# ==============================================================================
# Required for: cloning private repos, pushing fixes, creating PRs

# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
# Click: New token (classic) → select repo + workflow → Generate
GITHUB_TOKEN=

# Your GitHub username (used in commit author)
GITHUB_USERNAME=

# Email used in git commits
GITHUB_EMAIL=pulse-agent@devops.local

# ==============================================================================
# GITHUB OAUTH (OPTIONAL — for user-based authentication)
# ==============================================================================
# Only needed if you want users to log in with GitHub
# Create OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==============================================================================
# DATABASE
# ==============================================================================
# SQLite — no setup needed, file created automatically
# Path is relative to where you run uvicorn (the backend/ folder)
DATABASE_URL=sqlite+aiosqlite:///./pulse_agent.db

# ==============================================================================
# VECTOR MEMORY — PHASE 4
# ==============================================================================
# ChromaDB stores bug-fix patterns so PULSE learns from past fixes
# Leave as default for local development
VECTOR_DB_PATH=./pulse_memory
VECTOR_DB_TYPE=chromadb

# ==============================================================================
# AGENT BEHAVIOR
# ==============================================================================

# Maximum files to scan per run (higher = more thorough but slower)
MAX_SCAN_FILES=50

# Maximum CI/CD retry attempts before giving up
MAX_FIX_ATTEMPTS=5

# Seconds to wait between CI/CD status checks
RETRY_DELAY_SECONDS=30

# Subprocess timeout in seconds (for pylint, flake8, etc.)
SANDBOX_TIMEOUT=60

# ==============================================================================
# OFFLINE MODE
# ==============================================================================
# Set to true to use rule-based fixes only (no API calls)
# Useful for: testing, no-internet environments, cost savings
OFFLINE_MODE=false

# ==============================================================================
# FRONTEND
# ==============================================================================
# URL where the React frontend runs (for CORS and OAuth redirects)
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
